# ==============================================================================
# BLUEPRINT TEMPLATE: ENVIRONMENT CONFIGURATION
# Provide your new services / database alternatives here
# ==============================================================================

# Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_database_password_here
MYSQL_DATABASE=your_database_name
MYSQL_SSL=false

# Backend API
REACT_APP_API_URL=http://localhost:5000

# Email Delivery (e.g. Gmail App Password, SMTP, or custom alternative)
GMAIL_USER=your_email@domain.com
GMAIL_APP_PASSWORD=your_app_password

# Security & Tokens
JWT_SECRET=your_secure_jwt_secret_key

# Turnstile / Captcha (Optional)
REACT_APP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Application Base URL
APP_BASE_URL=http://localhost:3000
